<!-- =========================================================
     COZYNEST NAVBAR
========================================================= -->

<nav class="navbar navbar-expand-xl">

    <div class="container-fluid">


        <!-- =================================================
             LOGO + EXPLORE STAYS
        ================================================== -->

        <div class="brand-wrapper">

            <a
                class="navbar-brand"
                href="/listings"
            >

                <img
                    src="/images/cozynest.png"
                    alt="Cozynest Logo"
                    class="logo-img"
                >

            </a>


            <!-- Desktop -->

            <a
                href="/listings"
                class="nav-brand-text"
            >

                Explore Stays

            </a>

        </div>



        <!-- =================================================
             MOBILE TOGGLE
        ================================================== -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >

            <span class="navbar-toggler-icon"></span>

        </button>



        <!-- =================================================
             NAVBAR CONTENT
        ================================================== -->

        <div
            class="collapse navbar-collapse"
            id="navbarNavAltMarkup"
        >


            <!-- =================================================
                 MOBILE EXPLORE STAYS
            ================================================== -->

            <div class="mobile-menu-title">

                <a href="/listings">

                    Explore Stays

                </a>

            </div>



            <!-- =================================================
                 SEARCH
            ================================================== -->

            <div class="search-wrapper">

                <form
                    class="d-flex"
                    role="search"
                    action="/listings"
                    method="GET"
                >


                    <input
                        class="form-control search-inp"
                        type="search"
                        name="search"
                        placeholder="Search destinations"
                        value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>"
                        autocomplete="off"
                    >


                    <button
                        class="btn search-btn"
                        type="submit"
                    >


                        <i class="fa-solid fa-magnifying-glass"></i>


                        Search


                    </button>


                </form>

            </div>



            <!-- =================================================
                 RIGHT NAVIGATION
            ================================================== -->

            <div class="navbar-nav ms-auto right-nav">


                <!-- =================================================
                     HOST YOUR PLACE
                ================================================== -->

                <a
                    class="nav-link host-link"
                    href="/listings/new"
                >

                    Host Your Place

                </a>



                <!-- =================================================
                     LOGGED OUT
                ================================================== -->

                <% if(!currUser){ %>


                    <!-- Sign Up -->

                    <a
                        href="/signup"
                        class="signup-btn"
                    >

                        Sign Up

                    </a>


                    <!-- Login -->

                    <a
                        href="/login"
                        class="login-btn"
                    >

                        Login

                    </a>


                <% } else { %>



                    <!-- =================================================
                         LOGGED IN
                    ================================================== -->

                    <div class="dropdown profile-dropdown">


                        <!-- Profile Button -->

                        <button
                            class="profile-dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >


                            <!-- Avatar -->

                            <span class="profile-avatar">

                                <%= currUser.username.charAt(0).toUpperCase() %>

                            </span>


                            <!-- Username -->

                            <span class="profile-name">

                                <%= currUser.username %>

                            </span>


                            <!-- Arrow -->

                            <i class="fa-solid fa-chevron-down profile-arrow"></i>


                        </button>



                        <!-- =================================================
                             DROPDOWN
                        ================================================== -->

                        <ul class="dropdown-menu dropdown-menu-end profile-menu">

                            <!-- My Profile -->

                            <li>
                                <a
                                    class="dropdown-item profile-menu-item"
                                    href="/profile"
                                >
                                    <i class="fa-regular fa-user"></i>
                                    <span>
                                        My Profile
                                    </span>
                                </a>
                            </li>

                            <!-- My Listings -->

                            <li>
                                <a
                                    class="dropdown-item profile-menu-item"
                                    href="/listings/my-listings"
                                >
                                    <i class="fa-solid fa-house"></i>
                                    <span>My Listings</span>
                                </a>

                            </li>



                            <!-- My Bookings -->

                            <li>

                                <a
                                    class="dropdown-item profile-menu-item"
                                    href="/bookings"
                                >

                                    <i class="fa-regular fa-bookmark"></i>

                                    <span>
                                        My Bookings
                                    </span>

                                </a>

                            </li>



                            <!-- Wishlist -->

                            <li>

                                <a
                                    class="dropdown-item profile-menu-item"
                                    href="/wishlist"
                                >

                                    <i class="fa-regular fa-heart"></i>

                                    <span>
                                        Wishlist
                                    </span>

                                </a>

                            </li>



                            <!-- Divider -->

                            <li>

                                <hr class="dropdown-divider">

                            </li>



                            <!-- Logout -->

                            <li>

                                <a
                                    class="dropdown-item profile-menu-item logout-item"
                                    href="/logout"
                                >

                                    <i class="fa-solid fa-right-from-bracket"></i>

                                    <span>
                                        Logout
                                    </span>

                                </a>

                            </li>


                        </ul>


                    </div>


                <% } %>


            </div>


        </div>


    </div>

</nav>